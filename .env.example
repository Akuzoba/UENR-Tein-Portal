# Copy to .env.local for local development. On Vercel, set the same names under Project → Settings → Environment Variables.

# --- Supabase (Project → Connect / Project Settings → API) ---
# Transaction pooler connection string (port 6543), with your database password filled in.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# "service_role" secret key. Server-only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Public address of the main site. On Vercel this defaults to your production domain.
# NEXT_PUBLIC_SITE_URL=https://uenr-tein.vercel.app
# Optional: serve the membership portal from its own domain (see README → Domains).
# NEXT_PUBLIC_PORTAL_URL=https://portal.uenr-tein.org

# --- Admin ---
# Password for the default "admin" account created on first run (defaults to Admin@123). Change it after logging in.
# ADMIN_INITIAL_PASSWORD=

# --- Payments ---
# sk_test_...  -> real Paystack checkout in test mode (test numbers, no real money)
# sk_live_...  -> live payments
# empty        -> built-in test checkout in development; DISABLED in production unless ALLOW_TEST_CHECKOUT=true
PAYSTACK_SECRET_KEY=
# ALLOW_TEST_CHECKOUT=true
PAYSTACK_CURRENCY=GHS
# Starting fee only. Admins change it any time in Admin → Settings → Membership fee.
MEMBERSHIP_FEE=20

# Card validity is no longer a setting: it runs from the year of payment until the member completes
# their programme (programme length − current level, at least one year). See yearsLeft in lib/config.ts.
